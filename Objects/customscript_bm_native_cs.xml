<?xml version="1.0" encoding="UTF-8"?>
<clientscript scriptid="customscript_bm_native_cs">
  <description>Bank Match – Injects Auto-Reconcile button into the native Match Bank Data page</description>
  <isinactive>F</isinactive>
  <name>BM Native Page Enhancement</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifygroup></notifygroup>
  <notifyowner>T</notifyowner>
  <scriptfile>[/SuiteScripts/BankMatch/BM_NativePage_CS.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_bm_native_cs">
      <!--
        Deployed globally so the pageInit function can detect when the user
        is on the Match Bank Data page and inject our button bar.
        The script exits immediately on any other page (URL check).
      -->
      <allemployees>T</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <eventtype></eventtype>
      <isdeployed>T</isdeployed>
      <recordtype>bankstatementmatch</recordtype>
      <isinactive>F</isinactive>
      <loglevel>ERROR</loglevel>
      <status>RELEASED</status>
      <title>BM Native Page Enhancement</title>
    </scriptdeployment>
  </scriptdeployments>
</clientscript>
