<?xml version="1.0" encoding="UTF-8"?>
<customrecordtype scriptid="customrecord_bm_bank_txn">
  <accesstype>CUSTRECORDENTRYPERM</accesstype>
  <allowattachments>F</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>T</allowinlineediting>
  <allowquickadd>F</allowquickadd>
  <allowuiaccess>T</allowuiaccess>
  <enablekeywords>T</enablekeywords>
  <enablemailmerge>F</enablemailmerge>
  <enablenumbering>F</enablenumbering>
  <customrecordcustomfields>

    <customrecordcustomfield scriptid="custrecord_bm_txn_date">
      <fieldtype>DATE</fieldtype>
      <label>Transaction Date</label>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_txn_desc">
      <fieldtype>TEXT</fieldtype>
      <label>Description</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_txn_amount">
      <fieldtype>CURRENCY</fieldtype>
      <label>Amount</label>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Positive = credit (money received), Negative = debit (money paid out).</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_txn_ref">
      <fieldtype>TEXT</fieldtype>
      <label>Bank Reference</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_txn_currency">
      <fieldtype>TEXT</fieldtype>
      <label>Currency</label>
      <ismandatory>F</ismandatory>
      <defaultvalue>USD</defaultvalue>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_txn_status">
      <fieldtype>SELECT</fieldtype>
      <label>Status</label>
      <selectrecordtype>[scriptid=customlist_bm_txn_status]</selectrecordtype>
      <ismandatory>T</ismandatory>
      <defaultvalue>1</defaultvalue>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_txn_bank_acct">
      <fieldtype>SELECT</fieldtype>
      <label>Bank Account</label>
      <selectrecordtype>-10</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

  </customrecordcustomfields>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <name>BM Bank Transaction</name>
  <recordname>Bank Transaction</recordname>
  <showcreationdate>T</showcreationdate>
  <showlastmodified>T</showlastmodified>
  <showowner>F</showowner>
</customrecordtype>
