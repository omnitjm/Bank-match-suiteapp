<?xml version="1.0" encoding="UTF-8"?>
<customrecordtype scriptid="customrecord_bm_proposal">
  <accesstype>CUSTRECORDENTRYPERM</accesstype>
  <allowattachments>F</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>F</allowinlineediting>
  <allowquickadd>F</allowquickadd>
  <allowuiaccess>T</allowuiaccess>
  <enablekeywords>T</enablekeywords>
  <enablemailmerge>F</enablemailmerge>
  <enablenotes>T</enablenotes>
  <enablenumbering>F</enablenumbering>
  <customrecordcustomfields>

    <!-- ── Bank transaction link ────────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_bank_txn">
      <fieldtype>SELECT</fieldtype>
      <label>Bank Transaction</label>
      <selectrecordtype>[scriptid=customrecord_bm_bank_txn]</selectrecordtype>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <!-- ── Transaction type (Customer Payment / Bill Payment) ─ -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_txn_type">
      <fieldtype>SELECT</fieldtype>
      <label>Transaction Type</label>
      <selectrecordtype>[scriptid=customlist_bm_txn_type]</selectrecordtype>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <!-- ── NetSuite record details ──────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_ns_type">
      <fieldtype>TEXT</fieldtype>
      <label>NS Record Type</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Internal NetSuite record type string (e.g. invoice, vendorpayment).</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_ns_id">
      <fieldtype>INTEGER</fieldtype>
      <label>NS Record ID</label>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_ns_ref">
      <fieldtype>TEXT</fieldtype>
      <label>NS Transaction #</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_match_amt">
      <fieldtype>CURRENCY</fieldtype>
      <label>NS Match Amount</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_match_date">
      <fieldtype>DATE</fieldtype>
      <label>NS Match Date</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <!-- ── Bank transaction snapshot ───────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_bank_amt">
      <fieldtype>CURRENCY</fieldtype>
      <label>Bank Amount</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_bank_date">
      <fieldtype>DATE</fieldtype>
      <label>Bank Date</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_bank_ref">
      <fieldtype>TEXT</fieldtype>
      <label>Bank Reference</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <!-- ── Approval & result ────────────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_status">
      <fieldtype>SELECT</fieldtype>
      <label>Status</label>
      <selectrecordtype>[scriptid=customlist_bm_prop_status]</selectrecordtype>
      <ismandatory>T</ismandatory>
      <defaultvalue>1</defaultvalue>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Change to Approved to execute the reconciliation. Change to Rejected to decline.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_approver">
      <fieldtype>SELECT</fieldtype>
      <label>Approver</label>
      <selectrecordtype>-4</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <!-- ── Bill Payment date adjustment ────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_adj_date">
      <fieldtype>CHECKBOX</fieldtype>
      <label>Adjust Payment Date in NetSuite</label>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>When checked (Bill Payment only), the Vendor Payment trandate will be updated to match the Bank Date on approval.</helptext>
    </customrecordcustomfield>

    <!-- ── Notes & result tracking ──────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_notes">
      <fieldtype>TEXTAREA</fieldtype>
      <label>Notes</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_applied_dt">
      <fieldtype>DATE</fieldtype>
      <label>Applied Date</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_error_msg">
      <fieldtype>TEXTAREA</fieldtype>
      <label>Error Message</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <!-- ── Native bank line reference ──────────────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_prop_bank_line">
      <fieldtype>TEXT</fieldtype>
      <label>Native Bank Line ID</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Internal ID of the bank statement line from NetSuite's native Match Bank Data module.</helptext>
    </customrecordcustomfield>

    <!-- ── Idempotency key ──────────────────────────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_idempotency_key">
      <fieldtype>TEXT</fieldtype>
      <label>Idempotency Key</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Deduplication key: bankLineId or date|amount|ref composite. Prevents duplicate proposals for the same bank line.</helptext>
    </customrecordcustomfield>

    <!-- ── Apply locking & result tracking ─────────────────────────────── -->
    <customrecordcustomfield scriptid="custrecord_bm_apply_status">
      <fieldtype>TEXT</fieldtype>
      <label>Apply Status</label>
      <ismandatory>F</ismandatory>
      <defaultvalue>Pending</defaultvalue>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Internal apply-execution status: Pending | Processing | Applied | Failed. Do not edit manually.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_apply_attempts">
      <fieldtype>INTEGER</fieldtype>
      <label>Apply Attempts</label>
      <ismandatory>F</ismandatory>
      <defaultvalue>0</defaultvalue>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Number of times the apply logic has been executed for this proposal.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_apply_error">
      <fieldtype>TEXTAREA</fieldtype>
      <label>Apply Error</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Last error message from the apply execution. Populated when Apply Status is Failed.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_applied_txn_id">
      <fieldtype>TEXT</fieldtype>
      <label>Applied NS Transaction ID</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Internal ID of the NetSuite transaction created or updated when this proposal was applied.</helptext>
    </customrecordcustomfield>

    <!-- ── Variance / Tolerance metadata ──────────────────────────────────── -->

    <customrecordcustomfield scriptid="custrecord_bm_prop_has_variance">
      <fieldtype>CHECKBOX</fieldtype>
      <label>Has Variance</label>
      <ismandatory>F</ismandatory>
      <defaultchecked>F</defaultchecked>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Checked when the auto-match found a strong document-number reference but the bank amount differs from the open balance by up to the configured tolerance. The variance will be posted to the Bank Fee Account on approval.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_prop_variance_amt">
      <fieldtype>CURRENCY</fieldtype>
      <label>Variance Amount</label>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Absolute difference between the bank amount and the NetSuite open balance when a Match with Variance is detected. Posted to the Default Bank Fee Account on approval.</helptext>
    </customrecordcustomfield>

    <!-- ── Reversal tracking ───────────────────────────────────────────────── -->

    <customrecordcustomfield scriptid="custrecord_bm_reversed_date">
      <fieldtype>DATE</fieldtype>
      <label>Reversed Date</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Date when this applied proposal was reversed.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_reversed_by">
      <fieldtype>SELECT</fieldtype>
      <label>Reversed By</label>
      <selectrecordtype>-4</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Employee who initiated the reversal.</helptext>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_reversed_txn_ids">
      <fieldtype>TEXT</fieldtype>
      <label>Reversed Transaction IDs</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Comma-separated internal IDs of NetSuite transactions that were voided during reversal.</helptext>
    </customrecordcustomfield>

    <!-- ── Many-to-one matching ──────────────────────────────────────────── -->

    <customrecordcustomfield scriptid="custrecord_bm_prop_matched_ids">
      <fieldtype>TEXT</fieldtype>
      <label>Matched NS Record IDs</label>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>Comma-separated internal IDs when a single bank line is matched to multiple invoices or bills (many-to-one).</helptext>
    </customrecordcustomfield>

    <!-- ── Bank Account link (for multi-account filtering) ────────────────── -->

    <customrecordcustomfield scriptid="custrecord_bm_prop_bank_acct">
      <fieldtype>SELECT</fieldtype>
      <label>Bank Account</label>
      <selectrecordtype>-10</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
      <helptext>The GL bank account this proposal belongs to. Populated automatically from the active bank account context when the proposal is created. Used by the Global Overview to count proposals per account.</helptext>
    </customrecordcustomfield>

  </customrecordcustomfields>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <name>BM Match Proposal</name>
  <recordname>Match Proposal</recordname>
  <showcreationdate>T</showcreationdate>
  <showlastmodified>T</showlastmodified>
  <showowner>T</showowner>
</customrecordtype>
