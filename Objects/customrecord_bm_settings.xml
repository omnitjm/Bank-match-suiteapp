<?xml version="1.0" encoding="UTF-8"?>
<customrecordtype scriptid="customrecord_bm_settings">
  <accesstype>CUSTRECORDENTRYPERM</accesstype>
  <allowattachments>F</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>T</allowinlineediting>
  <allowquickadd>F</allowquickadd>
  <allowuiaccess>T</allowuiaccess>
  <enablekeywords>F</enablekeywords>
  <enablenumbering>F</enablenumbering>
  <customrecordcustomfields>

    <customrecordcustomfield scriptid="custrecord_bm_bank_account">
      <fieldtype>SELECT</fieldtype>
      <label>Bank Account</label>
      <selectrecordtype>-10</selectrecordtype>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_subsidiary">
      <fieldtype>SELECT</fieldtype>
      <label>Subsidiary</label>
      <selectrecordtype>-117</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_tolerance_amt">
      <fieldtype>CURRENCY</fieldtype>
      <label>Amount Tolerance</label>
      <ismandatory>F</ismandatory>
      <defaultvalue>0.01</defaultvalue>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_tolerance_days">
      <fieldtype>INTEGER</fieldtype>
      <label>Date Tolerance (days)</label>
      <ismandatory>F</ismandatory>
      <defaultvalue>5</defaultvalue>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_approver">
      <fieldtype>SELECT</fieldtype>
      <label>Approver</label>
      <selectrecordtype>-4</selectrecordtype>
      <ismandatory>T</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_auto_suggest">
      <fieldtype>CHECKBOX</fieldtype>
      <label>Auto-suggest Matches on Import</label>
      <ismandatory>F</ismandatory>
      <defaultchecked>T</defaultchecked>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_fee_account">
      <fieldtype>SELECT</fieldtype>
      <label>Default Bank Fee Account</label>
      <selectrecordtype>-10</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_suspense_account">
      <fieldtype>SELECT</fieldtype>
      <label>Default Suspense Account</label>
      <selectrecordtype>-10</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>T</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_default_department">
      <fieldtype>SELECT</fieldtype>
      <label>Default Department</label>
      <selectrecordtype>-123</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_default_class">
      <fieldtype>SELECT</fieldtype>
      <label>Default Class</label>
      <selectrecordtype>-101</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

    <customrecordcustomfield scriptid="custrecord_bm_default_location">
      <fieldtype>SELECT</fieldtype>
      <label>Default Location</label>
      <selectrecordtype>-104</selectrecordtype>
      <ismandatory>F</ismandatory>
      <showinlist>F</showinlist>
      <isformula>F</isformula>
      <encryptatrest>F</encryptatrest>
    </customrecordcustomfield>

  </customrecordcustomfields>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <recordname>Settings</recordname>
  <showcreationdate>F</showcreationdate>
  <showlastmodified>T</showlastmodified>
  <showowner>F</showowner>
</customrecordtype>
